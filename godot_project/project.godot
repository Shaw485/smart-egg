config_version=5

[application]

config/name="大聪明脑洞蛋"
config/description="一款手绘涂鸦风的「反套路」脑洞解谜手游（本期：第1关教学关《进门就过关了!》）"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/GameManager.gd"
SaveManager="*res://scripts/SaveManager.gd"
LevelManager="*res://scripts/LevelLoader.gd"
UIManager="*res://scripts/UIManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="keep_aspect"
window/stretch/aspect="keep"
window/handheld/orientation=1

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.988, 0.988, 0.988, 1)

